# Database
DATABASE_POSTGRES_PRISMA_URL="postgresql://username:password@localhost:5432/moodovermuscle?schema=public"

# Email Configuration
# Gmail rewrites the From header unless it matches the authenticated account,
# so EMAIL_FROM and SMTP_USER are deliberately the same address.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="moodovermuscle@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="moodovermuscle@gmail.com"
ADMIN_EMAIL="moodovermuscle@gmail.com"

# Admin Authentication
ADMIN_JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Optional: Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""
